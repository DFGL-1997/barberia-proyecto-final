# ===================================================
# Variables de entorno para BarberIA
# ===================================================

# Base de Datos
DB_ROOT_PASSWORD=mysql
DB_USER=root
DB_PASSWORD=mysql

# Base de Datos - Nombres
DB_CLIENTES_NAME=db_clientes
DB_SERVICIOS_NAME=db_servicios
DB_CITAS_NAME=db_citas

# Hosts de Base de Datos
DB_CLIENTES_HOST=mysql-clientes
DB_SERVICIOS_HOST=mysql-servicios
DB_CITAS_HOST=mysql-citas

# Puertos de Base de Datos
DB_CLIENTES_PORT=3306
DB_SERVICIOS_PORT=3307
DB_CITAS_PORT=3308

# Puertos de Microservicios
MS_USUARIOS_PORT=3001
MS_SERVICIOS_PORT=3002
MS_CITAS_PORT=3003
MS_ANALYTICS_PORT=3004

# Puertos de HAProxy
HAPROXY_API_PORT=8080
HAPROXY_STATS_PORT=8404

# Puerto Frontend
FRONTEND_PORT=80

# Spark
SPARK_MASTER_HOST=192.168.100.3
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=9090
SPARK_WORKER_WEBUI_PORT=9091

# CORS
CORS_ORIGIN=*

# Modo debug
NODE_ENV=production
