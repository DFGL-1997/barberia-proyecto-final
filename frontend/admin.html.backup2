<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>BarberIA - Admin</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --gold: #c9a84c;
    --gold-light: #e8c96d;
    --gold-dim: rgba(201,168,76,0.15);
    --bg: #0c0c0c;
    --sidebar: #101010;
    --surface: #141414;
    --surface2: #1c1c1c;
    --border: #252525;
    --border2: #333;
    --text: #f0ede6;
    --text-dim: #666;
    --text-mid: #999;
    --danger: #e05252;
    --success: #52c47a;
    --warning: #f0a843;
    --sidebar-w: 240px;
  }

  html, body { height: 100%; background: var(--bg); font-family: 'DM Sans', sans-serif; color: var(--text); }

  .sidebar {
    position: fixed;
    top: 0; left: 0; bottom: 0;
    width: var(--sidebar-w);
    background: var(--sidebar);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    z-index: 100;
  }

  .sidebar-brand {
    padding: 28px 24px 24px;
    border-bottom: 1px solid var(--border);
  }

  .sidebar-brand .name {
    font-family: 'Playfair Display', serif;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.5px;
  }

  .sidebar-brand .name span { color: var(--gold); }

  .sidebar-brand .role-badge {
    display: inline-block;
    margin-top: 6px;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gold);
    background: var(--gold-dim);
    border: 1px solid rgba(201,168,76,0.3);
    padding: 2px 8px;
    border-radius: 20px;
  }

  .sidebar-nav {
    flex: 1;
    padding: 20px 12px;
  }

  .nav-label {
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-dim);
    padding: 8px 12px 6px;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 12px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 14px;
    color: var(--text-mid);
    transition: all 0.18s;
    margin-bottom: 2px;
    border: 1px solid transparent;
  }

  .nav-item:hover {
    background: var(--surface2);
    color: var(--text);
  }

  .nav-item.active {
    background: var(--gold-dim);
    color: var(--gold);
    border-color: rgba(201,168,76,0.2);
  }

  .nav-item .icon {
    width: 18px;
    text-align: center;
    font-size: 13px;
    flex-shrink: 0;
    font-weight: 700;
  }

  .sidebar-footer {
    padding: 16px 12px;
    border-top: 1px solid var(--border);
  }

  .btn-logout {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    background: none;
    border: 1px solid var(--border2);
    color: var(--text-mid);
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.18s;
  }

  .btn-logout:hover {
    background: rgba(224,82,82,0.1);
    border-color: rgba(224,82,82,0.3);
    color: var(--danger);
  }

  .main {
    margin-left: var(--sidebar-w);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .topbar {
    padding: 20px 36px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .page-title {
    font-family: 'Playfair Display', serif;
    font-size: 26px;
    font-weight: 700;
  }

  .topbar-right {
    font-family: 'DM Mono', monospace;
    font-size: 12px;
    color: var(--text-dim);
  }

  .content {
    padding: 32px 36px;
    flex: 1;
  }

  .section { display: none; }
  .section.active { display: block; animation: fadeIn 0.25s ease; }

  @keyframes fadeIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 32px;
  }

  .stat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 22px 20px;
    position: relative;
    overflow: hidden;
  }

  .stat-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--gold);
    opacity: 0.5;
  }

  .stat-label {
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 12px;
  }

  .stat-value {
    font-family: 'Playfair Display', serif;
    font-size: 36px;
    font-weight: 700;
    color: var(--gold);
    line-height: 1;
  }

  .stat-value.small {
    font-size: 26px;
  }

  .stat-sub {
    font-size: 11px;
    color: var(--text-dim);
    margin-top: 6px;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }

  .card-header {
    padding: 20px 24px 18px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-title {
    font-family: 'Playfair Display', serif;
    font-size: 18px;
    font-weight: 700;
  }

  .card-body { padding: 24px; }

  .tbl-wrap { overflow-x: auto; }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
  }

  thead th {
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-dim);
    padding: 12px 16px;
    text-align: left;
    border-bottom: 1px solid var(--border);
    font-weight: 500;
  }

  tbody td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
    color: var(--text-mid);
    vertical-align: middle;
  }

  tbody tr:last-child td { border-bottom: none; }
  tbody tr:hover td { background: var(--surface2); }
  td.name-cell { color: var(--text); font-weight: 500; }
  td.mono { font-family: 'DM Mono', monospace; font-size: 13px; }

  .badge {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: capitalize;
  }

  .badge.pendiente { background: rgba(240,168,67,0.15); color: var(--warning); border: 1px solid rgba(240,168,67,0.3); }
  .badge.atendida  { background: rgba(82,196,122,0.15); color: var(--success); border: 1px solid rgba(82,196,122,0.3); }
  .badge.cancelada { background: rgba(224,82,82,0.12); color: #e88; border: 1px solid rgba(224,82,82,0.25); }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border-radius: 7px;
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: all 0.18s;
    letter-spacing: 0.3px;
  }

  .btn-gold {
    background: var(--gold);
    color: #0c0c0c;
  }

  .btn-gold:hover { background: var(--gold-light); }

  .btn-outline {
    background: transparent;
    border: 1px solid var(--border2);
    color: var(--text-mid);
  }

  .btn-outline:hover { border-color: var(--gold); color: var(--gold); }

  .btn-danger-outline {
    background: transparent;
    border: 1px solid rgba(224,82,82,0.3);
    color: var(--danger);
  }

  .btn-danger-outline:hover { background: rgba(224,82,82,0.1); }
  .btn-sm { padding: 5px 10px; font-size: 11px; }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr auto;
    gap: 12px;
    align-items: end;
  }

  .f-group label {
    display: block;
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 7px;
  }

  .f-input {
    background: var(--surface2);
    border: 1px solid var(--border2);
    color: var(--text);
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    padding: 10px 13px;
    border-radius: 8px;
    width: 100%;
    outline: none;
    transition: border-color 0.2s;
  }

  .f-input:focus { border-color: var(--gold); }

  .f-select {
    background: var(--surface2);
    border: 1px solid var(--border);
    color: var(--text-mid);
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    padding: 6px 10px;
    border-radius: 7px;
    cursor: pointer;
    outline: none;
  }

  .f-select:focus { border-color: var(--gold); color: var(--text); }

  .filters-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 24px;
    border-bottom: 1px solid var(--border);
    background: var(--surface2);
  }

  .filter-label {
    font-size: 11px;
    color: var(--text-dim);
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .earnings-badge {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--text-mid);
  }

  .earnings-amount {
    font-family: 'DM Mono', monospace;
    font-size: 18px;
    color: var(--gold);
    font-weight: 500;
  }

  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.7);
    z-index: 200;
    display: none;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(4px);
  }

  .modal-backdrop.open { display: flex; animation: fadeIn 0.2s ease; }

  .modal {
    background: var(--surface);
    border: 1px solid var(--border2);
    border-radius: 16px;
    width: 100%;
    max-width: 480px;
    padding: 32px;
    position: relative;
    animation: slideUp 0.25s ease;
  }

  @keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

  .modal-title {
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }

  .modal-close {
    position: absolute;
    top: 20px; right: 20px;
    background: none;
    border: none;
    color: var(--text-dim);
    font-size: 20px;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 4px;
    transition: color 0.2s;
  }

  .modal-close:hover { color: var(--text); }

  .modal-field { margin-bottom: 16px; }
  .modal-field label { display: block; font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text-dim); margin-bottom: 7px; }
  .modal-actions { display: flex; gap: 10px; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border); }

  .toast {
    position: fixed;
    bottom: 28px;
    right: 28px;
    background: var(--surface2);
    border: 1px solid var(--border2);
    border-left: 3px solid var(--gold);
    padding: 14px 20px;
    border-radius: 10px;
    font-size: 13px;
    color: var(--text);
    z-index: 999;
    transform: translateY(20px);
    opacity: 0;
    transition: all 0.3s ease;
    max-width: 320px;
  }

  .toast.show { transform: translateY(0); opacity: 1; }
  .toast.error { border-left-color: var(--danger); }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
    color: var(--text-dim);
  }

  .empty-state .icon { font-size: 40px; margin-bottom: 12px; }
  .empty-state p { font-size: 14px; }
</style>
</head>
<body>

<nav class="sidebar">
  <div class="sidebar-brand">
    <div class="name">Barber<span>IA</span></div>
    <span class="role-badge">Administrador</span>
  </div>

  <div class="sidebar-nav">
    <div class="nav-label">Principal</div>
    <div class="nav-item active" onclick="showSection('dashboard', this)">
      <span class="icon">D</span> Dashboard
    </div>
    <div class="nav-item" onclick="showSection('servicios', this)">
      <span class="icon">S</span> Servicios
    </div>
    <div class="nav-item" onclick="showSection('citas', this)">
      <span class="icon">C</span> Citas
    </div>
    <div class="nav-item" onclick="showSection('clientes', this)">
      <span class="icon">U</span> Clientes
    </div>
    <div class="nav-item" onclick="showSection('analytics', this)">
      <span class="icon">A</span> Analytics
    </div>
  </div>

  <div class="sidebar-footer">
    <button class="btn-logout" onclick="logout()">
      <span>X</span> Cerrar sesion
    </button>
  </div>
</nav>

<div class="main">
  <div class="topbar">
    <div class="page-title" id="pageTitle">Dashboard</div>
    <div class="topbar-right" id="topbarDate">-</div>
  </div>

  <div class="content">
    <div id="sec-dashboard" class="section active">
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-label">Citas hoy</div>
          <div class="stat-value" id="stat-citas-hoy">-</div>
          <div class="stat-sub">Total del dia</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Ingresos hoy</div>
          <div class="stat-value small" id="stat-ingresos">$-</div>
          <div class="stat-sub">Citas atendidas</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Servicios</div>
          <div class="stat-value" id="stat-servicios">-</div>
          <div class="stat-sub">Disponibles</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Clientes</div>
          <div class="stat-value" id="stat-clientes">-</div>
          <div class="stat-sub">Registrados</div>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <span class="card-title">Citas de hoy</span>
          <button class="btn btn-outline btn-sm" onclick="showSection('citas', document.querySelector('[onclick*=citas]'))">Ver todas -></button>
        </div>
        <div class="tbl-wrap">
          <table>
            <thead>
              <tr>
                <th>Cliente</th>
                <th>Servicio</th>
                <th>Barbero</th>
                <th>Hora</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody id="tbl-hoy"></tbody>
          </table>
        </div>
      </div>
    </div>

    <div id="sec-servicios" class="section">
      <div class="card" style="margin-bottom:24px;">
        <div class="card-header">
          <span class="card-title">Nuevo servicio</span>
        </div>
        <div class="card-body">
          <div class="form-grid">
            <div class="f-group">
              <label>Nombre del servicio</label>
              <input class="f-input" id="s-nombre" placeholder="Ej: Corte clasico">
            </div>
            <div class="f-group">
              <label>Precio ($)</label>
              <input class="f-input" id="s-precio" type="number" placeholder="25000">
            </div>
            <div class="f-group">
              <label>Duracion (min)</label>
              <input class="f-input" id="s-duracion" type="number" placeholder="30">
            </div>
            <div class="f-group">
              <label>&nbsp;</label>
              <button class="btn btn-gold" onclick="guardarServicio()">
                <span id="s-btn-text">+ Crear</span>
              </button>
            </div>
          </div>
          <input type="hidden" id="s-id">
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <span class="card-title">Servicios registrados</span>
          <span id="s-count" style="font-size:12px;color:var(--text-dim)"></span>
        </div>
        <div class="tbl-wrap">
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Precio</th>
                <th>Duracion</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody id="tbl-servicios"></tbody>
          </table>
        </div>
      </div>
    </div>

    <div id="sec-citas" class="section">
      <div class="card">
        <div class="filters-bar">
          <span class="filter-label">Filtrar por fecha</span>
          <input type="date" class="f-input" id="filtro-fecha" style="width:160px;padding:7px 12px">
          <button class="btn btn-outline btn-sm" onclick="document.getElementById('filtro-fecha').value=''; cargarCitas()">Limpiar</button>
          <div class="earnings-badge">
            <span>Total atendidas:</span>
            <span class="earnings-amount">$<span id="total-dia">0</span></span>
          </div>
        </div>
        <div class="tbl-wrap">
          <table>
            <thead>
              <tr>
                <th>Cliente</th>
                <th>Servicio</th>
                <th>Barbero</th>
                <th>Precio</th>
                <th>Fecha</th>
                <th>Hora</th>
                <th>Pago</th>
                <th>Estado</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody id="tbl-citas"></tbody>
          </table>
        </div>
        <div id="paginacion-citas" style="display:flex;align-items:center;justify-content:center;gap:16px;padding:16px;border-top:1px solid var(--border)"></div>
      </div>
    </div>

    <div id="sec-clientes" class="section">
      <div class="card">
        <div class="card-header">
          <span class="card-title">Clientes registrados</span>
          <span id="c-count" style="font-size:12px;color:var(--text-dim)"></span>
        </div>
        <div class="tbl-wrap">
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Usuario</th>
                <th>Telefono</th>
                <th>Email</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody id="tbl-clientes"></tbody>
          </table>
        </div>
        <div id="paginacion-clientes" style="display:flex;align-items:center;justify-content:center;gap:16px;padding:16px;border-top:1px solid var(--border)"></div>
      </div>
    </div>
    <div id="sec-analytics" class="section">
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-label">Total Citas Analizadas</div>
          <div class="stat-value" id="an-total">-</div>
          <div class="stat-sub">Procesadas con Spark</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Servicio Top</div>
          <div class="stat-value small" id="an-servicio-top">-</div>
          <div class="stat-sub">Más solicitado</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Barbero Top</div>
          <div class="stat-value small" id="an-barbero-top">-</div>
          <div class="stat-sub">Más citas atendidas</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Pago Favorito</div>
          <div class="stat-value small" id="an-pago-top">-</div>
          <div class="stat-sub">Método más usado</div>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:24px">
        <div class="card">
          <div class="card-header"><span class="card-title">Servicios más populares</span></div>
          <div class="tbl-wrap">
            <table>
              <thead><tr><th>Servicio</th><th>Citas</th></tr></thead>
              <tbody id="tbl-servicios-pop"></tbody>
            </table>
          </div>
        </div>
        <div class="card">
          <div class="card-header"><span class="card-title">Barberos con más citas</span></div>
          <div class="tbl-wrap">
            <table>
              <thead><tr><th>Barbero</th><th>Citas</th></tr></thead>
              <tbody id="tbl-barberos-top"></tbody>
            </table>
          </div>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px">
        <div class="card">
          <div class="card-header"><span class="card-title">Métodos de pago</span></div>
          <div class="tbl-wrap">
            <table>
              <thead><tr><th>Método</th><th>Usos</th></tr></thead>
              <tbody id="tbl-pagos"></tbody>
            </table>
          </div>
        </div>
        <div class="card">
          <div class="card-header"><span class="card-title">Citas por estado</span></div>
          <div class="tbl-wrap">
            <table>
              <thead><tr><th>Estado</th><th>Total</th></tr></thead>
              <tbody id="tbl-estados"></tbody>
            </table>
          </div>
        </div>
      </div>
      <div style="margin-top:24px">
        <div class="card">
          <div class="card-header"><span class="card-title">Ingresos por mes (citas atendidas)</span></div>
          <div class="tbl-wrap">
            <table>
              <thead><tr><th>Año</th><th>Mes</th><th>Ingresos</th></tr></thead>
              <tbody id="tbl-ingresos"></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal-backdrop" id="modal-servicio">
  <div class="modal">
    <button class="modal-close" onclick="cerrarModal('modal-servicio')">X</button>
    <div class="modal-title">Editar servicio</div>
    <input type="hidden" id="me-id">
    <div class="modal-field">
      <label>Nombre</label>
      <input class="f-input" id="me-nombre">
    </div>
    <div class="modal-field">
      <label>Precio ($)</label>
      <input class="f-input" type="number" id="me-precio">
    </div>
    <div class="modal-field">
      <label>Duracion (min)</label>
      <input class="f-input" type="number" id="me-duracion">
    </div>
    <div class="modal-actions">
      <button class="btn btn-gold" onclick="actualizarServicio()">Guardar cambios</button>
      <button class="btn btn-outline" onclick="cerrarModal('modal-servicio')">Cancelar</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script>
const API_CLIENTES  = 'http://192.168.100.3:3001';
const API_SERVICIOS = 'http://192.168.100.3:3002/servicios';
const API_CITAS     = 'http://192.168.100.3:3003/citas';

let paginaActual = 1;
let paginaClientesActual = 1;

const sesionData = localStorage.getItem('usuario');
if (!sesionData) { window.location.href = 'index.html'; }
const sesion = sesionData ? JSON.parse(sesionData) : null;
if (sesion && sesion.rol !== 'admin') { window.location.href = 'cliente.html'; }

const now = new Date();
document.getElementById('topbarDate').textContent =
  now.toLocaleDateString('es-CO', { weekday:'long', year:'numeric', month:'long', day:'numeric' });

function showSection(id, el) {
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  document.getElementById('sec-' + id).classList.add('active');
  if (el) el.classList.add('active');
  const titles = { dashboard:'Dashboard', servicios:'Servicios', citas:'Citas', clientes:'Clientes' };
  document.getElementById('pageTitle').textContent = titles[id];
  if (id === 'servicios') cargarServicios();
  if (id === 'citas') cargarCitas();
  if (id === 'clientes') cargarClientes();
  if (id === 'analytics') cargarAnalytics();
}

function toast(msg, type='ok') {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'toast show' + (type === 'error' ? ' error' : '');
  setTimeout(() => t.classList.remove('show'), 3200);
}

function abrirModal(id) { document.getElementById(id).classList.add('open'); }
function cerrarModal(id) { document.getElementById(id).classList.remove('open'); }

async function cargarDashboard() {
  try {
    const [rCitas, rServicios, rClientes] = await Promise.all([
      axios.get(API_CITAS + '?pagina=1&limite=50'),
      axios.get(API_SERVICIOS),
      axios.get(`${API_CLIENTES}/clientes`)
    ]);

    const hoy = new Date().toISOString().slice(0,10);
    const citasHoy = rCitas.data.citas.filter(c => c.fecha && c.fecha.slice(0,10) === hoy);
    const ingresosHoy = citasHoy
      .filter(c => c.estado === 'atendida')
      .reduce((s, c) => s + parseFloat(c.precio || 0), 0);

    document.getElementById('stat-citas-hoy').textContent = citasHoy.length;
    document.getElementById('stat-ingresos').textContent = '$' + ingresosHoy.toLocaleString('es-CO');
    document.getElementById('stat-servicios').textContent = rServicios.data.length;
    document.getElementById('stat-clientes').textContent = rClientes.data.total;

    const tbody = document.getElementById('tbl-hoy');
    tbody.innerHTML = '';

    if (citasHoy.length === 0) {
      tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:var(--text-dim);padding:40px">Sin citas para hoy</td></tr>';
      return;
    }

    citasHoy.sort((a,b) => a.hora > b.hora ? 1 : -1).forEach(c => {
      tbody.innerHTML += `<tr>
        <td class="name-cell">${c.cliente || '-'}</td>
        <td>${c.servicio || '-'}</td>
        <td>${c.barbero || 'Sin preferencia'}</td>
        <td class="mono">${c.hora || '-'}</td>
        <td><span class="badge ${c.estado}">${c.estado}</span></td>
      </tr>`;
    });
  } catch (e) {
    console.error(e);
  }
}

async function cargarServicios() {
  try {
    const res = await axios.get(API_SERVICIOS);
    const tbody = document.getElementById('tbl-servicios');
    tbody.innerHTML = '';
    document.getElementById('s-count').textContent = res.data.length + ' registrados';

    if (res.data.length === 0) {
      tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:var(--text-dim);padding:40px">Sin servicios</td></tr>';
      return;
    }

    res.data.forEach(s => {
      tbody.innerHTML += `<tr>
        <td class="mono" style="color:var(--text-dim)">${s.id}</td>
        <td class="name-cell">${s.nombre}</td>
        <td class="mono">$${parseFloat(s.precio).toLocaleString('es-CO')}</td>
        <td>${s.duracion || 0} min</td>
        <td>
          <div style="display:flex;gap:6px">
            <button class="btn btn-outline btn-sm" onclick="abrirEditarServicio(${s.id},'${String(s.nombre).replace(/'/g,'\\\'')}',${s.precio},${s.duracion || 0})">Editar</button>
            <button class="btn btn-danger-outline btn-sm" onclick="eliminarServicio(${s.id})">Eliminar</button>
          </div>
        </td>
      </tr>`;
    });
  } catch (e) {
    toast('Error cargando servicios', 'error');
  }
}

async function guardarServicio() {
  const nombre = document.getElementById('s-nombre').value.trim();
  const precio = document.getElementById('s-precio').value;
  const duracion = document.getElementById('s-duracion').value;
  if (!nombre || !precio) return toast('Nombre y precio son requeridos.', 'error');

  try {
    await axios.post(API_SERVICIOS, { nombre, precio, duracion });
    document.getElementById('s-nombre').value = '';
    document.getElementById('s-precio').value = '';
    document.getElementById('s-duracion').value = '';
    toast('Servicio creado correctamente');
    cargarServicios();
    cargarDashboard();
  } catch (e) {
    toast('Error al crear servicio', 'error');
  }
}

function abrirEditarServicio(id, nombre, precio, duracion) {
  document.getElementById('me-id').value = id;
  document.getElementById('me-nombre').value = nombre;
  document.getElementById('me-precio').value = precio;
  document.getElementById('me-duracion').value = duracion;
  abrirModal('modal-servicio');
}

async function actualizarServicio() {
  const id = document.getElementById('me-id').value;
  const nombre = document.getElementById('me-nombre').value.trim();
  const precio = document.getElementById('me-precio').value;
  const duracion = document.getElementById('me-duracion').value;
  try {
    await axios.put(`${API_SERVICIOS}/${id}`, { nombre, precio, duracion });
    cerrarModal('modal-servicio');
    toast('Servicio actualizado');
    cargarServicios();
  } catch (e) {
    toast('Error al actualizar', 'error');
  }
}

async function eliminarServicio(id) {
  if (!confirm('Eliminar este servicio? Esta accion no se puede deshacer.')) return;
  try {
    await axios.delete(`${API_SERVICIOS}/${id}`);
    toast('Servicio eliminado');
    cargarServicios();
    cargarDashboard();
  } catch (e) {
    toast('Error al eliminar servicio', 'error');
  }
}

async function cargarCitas() {
  const filtroFecha = document.getElementById('filtro-fecha').value;
  try {
    const res = await axios.get(API_CITAS + '?pagina=' + paginaActual + '&limite=50');
    const tbody = document.getElementById('tbl-citas');
    tbody.innerHTML = '';

    let citas = res.data.citas;
    if (filtroFecha) {
      citas = citas.filter(c => c.fecha && c.fecha.slice(0,10) === filtroFecha);
    }

    const total = citas
      .filter(c => c.estado === 'atendida')
      .reduce((s, c) => s + parseFloat(c.precio || 0), 0);
    document.getElementById('total-dia').textContent = total.toLocaleString('es-CO');

    if (citas.length === 0) {
      tbody.innerHTML = '<tr><td colspan="9" style="text-align:center;color:var(--text-dim);padding:40px">Sin citas para mostrar</td></tr>';
      return;
    }

    citas.forEach(c => {
      const fecha = c.fecha ? c.fecha.slice(0,10) : '-';
      tbody.innerHTML += `<tr>
        <td class="name-cell">${c.cliente || '-'}</td>
        <td>${c.servicio || '-'}</td>
        <td>${c.barbero || 'Sin preferencia'}</td>
        <td class="mono">$${parseFloat(c.precio || 0).toLocaleString('es-CO')}</td>
        <td class="mono">${fecha}</td>
        <td class="mono">${c.hora || '-'}</td>
        <td>${c.metodo_pago || '-'}</td>
        <td>
          <select class="f-select" onchange="cambiarEstado(${c.id}, this.value)">
            <option value="pendiente" ${c.estado === 'pendiente' ? 'selected' : ''}>Pendiente</option>
            <option value="atendida" ${c.estado === 'atendida' ? 'selected' : ''}>Atendida</option>
            <option value="cancelada" ${c.estado === 'cancelada' ? 'selected' : ''}>Cancelada</option>
          </select>
        </td>
        <td>
          <button class="btn btn-danger-outline btn-sm" onclick="eliminarCita(${c.id})">Eliminar</button>
        </td>
      </tr>`;
    });

    // Paginación
    document.getElementById('paginacion-citas').innerHTML = `
      <button class="btn btn-outline btn-sm" onclick="cambiarPagina(-1)" ${paginaActual === 1 ? 'disabled' : ''}>← Anterior</button>
      <span style="color:var(--text-dim);font-size:12px">Página ${res.data.pagina} de ${res.data.totalPaginas} (${res.data.total} citas)</span>
      <button class="btn btn-outline btn-sm" onclick="cambiarPagina(1)" ${paginaActual >= res.data.totalPaginas ? 'disabled' : ''}>Siguiente →</button>
    `;
  } catch (e) {
    toast('Error cargando citas', 'error');
  }
}

function cambiarPagina(dir) {
  paginaActual += dir;
  cargarCitas();
}

async function cambiarEstado(id, estado) {
  try {
    await axios.put(`${API_CITAS}/${id}`, { estado });
    toast('Estado actualizado');
    cargarCitas();
    if (document.getElementById('sec-dashboard').classList.contains('active')) cargarDashboard();
  } catch (e) {
    toast('Error al cambiar estado', 'error');
  }
}

async function eliminarCita(id) {
  if (!confirm('Eliminar esta cita?')) return;
  try {
    await axios.delete(`${API_CITAS}/${id}`);
    toast('Cita eliminada');
    cargarCitas();
    cargarDashboard();
  } catch (e) {
    toast('Error al eliminar cita', 'error');
  }
}

document.getElementById('filtro-fecha').addEventListener('change', cargarCitas);

async function cargarClientes() {
  try {
    const res = await axios.get(`${API_CLIENTES}/clientes?pagina=${paginaClientesActual}&limite=100`);
    const tbody = document.getElementById('tbl-clientes');
    tbody.innerHTML = '';
    document.getElementById('c-count').textContent = res.data.total + ' registrados';

    if (res.data.clientes.length === 0) {
      tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--text-dim);padding:40px">Sin clientes</td></tr>';
      return;
    }

    res.data.clientes.forEach(c => {
      const rolBadge = c.rol === 'admin'
        ? '<span class="badge atendida">Admin</span>'
        : c.rol === 'barbero'
        ? '<span class="badge pendiente">Barbero</span>'
        : '<span class="badge">Cliente</span>';
      tbody.innerHTML += `<tr>
        <td class="mono" style="color:var(--text-dim)">${c.id}</td>
        <td class="name-cell">${c.nombre}</td>
        <td class="mono">${c.usuario}</td>
        <td>${c.telefono || '-'}</td>
        <td>${c.email || '-'}</td>
        <td>${rolBadge}</td>
      </tr>`;
    });

    document.getElementById('paginacion-clientes').innerHTML = `
      <button class="btn btn-outline btn-sm" onclick="cambiarPaginaClientes(-1)" ${paginaClientesActual === 1 ? 'disabled' : ''}>← Anterior</button>
      <span style="color:var(--text-dim);font-size:12px">Página ${res.data.pagina} de ${res.data.totalPaginas} (${res.data.total} clientes)</span>
      <button class="btn btn-outline btn-sm" onclick="cambiarPaginaClientes(1)" ${paginaClientesActual >= res.data.totalPaginas ? 'disabled' : ''}>Siguiente →</button>
    `;
  } catch (e) {
    toast('Error cargando clientes', 'error');
  }
}

function cambiarPaginaClientes(dir) {
  paginaClientesActual += dir;
  cargarClientes();
}

function logout() {
  localStorage.removeItem('usuario');
  window.location.href = 'index.html';
}

cargarDashboard();

const API_ANALYTICS = 'http://192.168.100.3:3004';

async function cargarAnalytics() {
  try {
    const res = await axios.get(`${API_ANALYTICS}/analytics`);
    const data = res.data;

    // Stats cards
    const totalCitas = data.citas_por_estado.reduce((s, e) => s + e.total, 0);
    document.getElementById('an-total').textContent = totalCitas.toLocaleString('es-CO');
    document.getElementById('an-servicio-top').textContent = data.servicios_populares[0]?.servicio || '-';
    document.getElementById('an-barbero-top').textContent = data.barberos_top[0]?.barbero || '-';
    document.getElementById('an-pago-top').textContent = data.metodos_pago[0]?.metodo_pago || '-';

    // Servicios populares
    const tblServ = document.getElementById('tbl-servicios-pop');
    tblServ.innerHTML = '';
    data.servicios_populares.forEach(s => {
      tblServ.innerHTML += `<tr>
        <td class="name-cell">${s.servicio}</td>
        <td class="mono">${s.total}</td>
      </tr>`;
    });

    // Barberos top
    const tblBarb = document.getElementById('tbl-barberos-top');
    tblBarb.innerHTML = '';
    data.barberos_top.forEach(b => {
      tblBarb.innerHTML += `<tr>
        <td class="name-cell">${b.barbero}</td>
        <td class="mono">${b.total}</td>
      </tr>`;
    });

    // Metodos de pago
    const tblPagos = document.getElementById('tbl-pagos');
    tblPagos.innerHTML = '';
    data.metodos_pago.forEach(p => {
      tblPagos.innerHTML += `<tr>
        <td class="name-cell">${p.metodo_pago}</td>
        <td class="mono">${p.total}</td>
      </tr>`;
    });

    // Estados
    const tblEstados = document.getElementById('tbl-estados');
    tblEstados.innerHTML = '';
    data.citas_por_estado.forEach(e => {
      tblEstados.innerHTML += `<tr>
        <td><span class="badge ${e.estado}">${e.estado}</span></td>
        <td class="mono">${e.total}</td>
      </tr>`;
    });

    // Ingresos por mes
    const meses = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
    const tblIngresos = document.getElementById('tbl-ingresos');
    tblIngresos.innerHTML = '';
    data.ingresos_por_mes.forEach(i => {
      tblIngresos.innerHTML += `<tr>
        <td class="mono">${i.anio}</td>
        <td class="name-cell">${meses[i.mes - 1]}</td>
        <td class="mono" style="color:var(--gold)">$${parseFloat(i.ingresos).toLocaleString('es-CO')}</td>
      </tr>`;
    });

  } catch (e) {
    toast('Error cargando analytics', 'error');
  }
}
</script>

</body>
</html>
